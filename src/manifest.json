{
  "manifest_version": 3,
  "name": "AskPage",
  "short_name": "AskPage",
  "version": "0.1.0",
  "description": "Pick any element on any page (or scan the whole page) and ask an LLM anything about it — extract, summarise, list, translate, audit. Powered by AgentForge.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AskPage",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-inspect": {
      "description": "Toggle AskPage inspect mode on the active tab"
    }
  }
}
